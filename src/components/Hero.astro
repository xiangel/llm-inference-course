---
/**
 * Starlight does not prefix hero.actions[].link with `base`.
 * Root-absolute paths like `/00-introduction/` therefore miss the
 * GitHub Pages subpath `/llm-inference-course/`.
 */
import Default from "@astrojs/starlight/components/Hero.astro";

const hero = Astro.locals.starlightRoute.entry.data.hero;
if (hero?.actions?.length) {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const withBase = (href: string) => {
    if (!href.startsWith("/") || href.startsWith("//")) return href;
    return `${base}${href}`;
  };
  hero.actions = hero.actions.map((action) => ({
    ...action,
    link: withBase(action.link),
  }));
}
---

<Default><slot /></Default>
