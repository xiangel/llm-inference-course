---
interface Link {
  href: string;
  title: string;
}

interface Props {
  section: string;
  difficulty: 1 | 2 | 3 | 4 | 5;
  readingTime: number;
  prev?: Link;
  next?: Link;
}

const { section, difficulty, readingTime, prev, next } = Astro.props;
const stars = "★".repeat(difficulty) + "☆".repeat(5 - difficulty);
const kicker = section.includes(".") ? `第 ${section} 节` : `第 ${section} 篇`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (href: string) => `${base}${href.startsWith("/") ? href : `/${href}`}`;
---

<aside class="chapter-meta" aria-label="章节信息">
  <p class="chapter-meta__kicker">{kicker}</p>
  <div class="chapter-meta__row">
    <span>难度：{stars}</span>
    <span>阅读时间：{readingTime} min</span>
  </div>
  <div class="chapter-meta__nav">
    {
      prev ? (
        <span>
          上一篇：<a href={withBase(prev.href)}>{prev.title}</a>
        </span>
      ) : (
        <span>上一篇：本书开头</span>
      )
    }
    {
      next ? (
        <span>
          下一篇：<a href={withBase(next.href)}>{next.title}</a>
        </span>
      ) : null
    }
  </div>
</aside>
